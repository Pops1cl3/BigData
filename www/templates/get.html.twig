{% extends "base.html.twig" %}
{% block content %}
    <h1>Détails du manuscrit</h1>
    <ul>
        <li><strong>ID :</strong> {{ document._id }}</li>
        <li><strong>Titre :</strong> {{ document.titre }}</li>
        <li><strong>Auteur :</strong> {{ document.auteur | default('Auteur inconnu') }}</li>
    </ul>
    <a href="app.php">Retour à la liste</a>
{% endblock %}